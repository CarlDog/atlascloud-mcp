{
  "name": "atlascloud-mcp",
  "version": "1.5.0",
  "description": "MCP server for AI image / video / 3D / audio (TTS, music, speech-to-text) generation & LLM chat. Use Sora 2, Veo 3, Kling 3, Seedance 2, Flux 2, Nano Banana Pro, Hunyuan 3D, Seed Audio, Suno in Claude Code, Cursor, Codex, Gemini CLI.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atlascloud-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "atlascloud",
    "atlas-cloud",
    "claude-code",
    "codex",
    "gemini-cli",
    "cursor",
    "cline",
    "sora-2",
    "veo-3",
    "kling-3",
    "seedance-2",
    "flux-2",
    "nano-banana",
    "gpt-image-2",
    "ai-video-generation",
    "text-to-image",
    "text-to-speech",
    "tts",
    "seed-audio",
    "hunyuan-3d",
    "image-to-3d",
    "llm",
    "image-generation",
    "video-generation",
    "audio-generation",
    "3d-generation",
    "music-generation",
    "suno",
    "speech-to-text",
    "asr",
    "transcription"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "express": "^4.21.0",
    "undici": "^7.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
