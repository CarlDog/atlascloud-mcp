{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // Tests must not reach dist/; tsconfig.typecheck.json covers them instead
  // (standard MCP-D01/D02). Kept minimal here — not adopting the canonical
  // template's stricter noUncheckedIndexedAccess/NodeNext/declaration:false,
  // since those could surface new type errors in upstream's untouched
  // business logic or change this package's emitted .d.ts shape.
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
