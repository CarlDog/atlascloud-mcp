# Get your free key: https://www.atlascloud.ai/console/api-keys?utm_source=github&utm_campaign=mcp-server
# Optional at startup — atlas_list_models/atlas_search_docs work without a
# key (unauthenticated catalog browsing). Required for generation/chat/
# balance tools; leave empty for stdio use if you only need the catalog.
ATLASCLOUD_API_KEY=

# ── HTTP transport (Docker/Portainer deployment) ──────────────────────────
# Leave MCP_PORT unset for stdio (the default, used by `docker run -i` /
# local MCP client configs above). Set it to serve Streamable HTTP instead.
# See README "Docker (Streamable HTTP)" / "Securing the HTTP endpoint".

# MCP_PORT=3000
# MCP_BIND_HOST=127.0.0.1

# Required whenever MCP_PORT is set. Comma-separated BARE hostnames (no
# port) this server accepts on /mcp — also covers the Origin header.
# MCP_ALLOWED_HOSTS=your-nas

# Optional but recommended: every tool call here can spend real Atlas
# Cloud credits.
# MCP_AUTH_TOKEN=

# Optional, default 30 minutes (1800000ms).
# MCP_SESSION_IDLE_MS=1800000

# LOG_LEVEL=info

# Required only if you'll call atlas_upload_media over HTTP transport —
# an absolute, stable host path (no relative default; see docker-compose.yml
# comment for why). Mounted to /data/uploads inside the container.
# HOST_UPLOAD_DIR=/volume1/docker/atlascloud-mcp/uploads

# Required in Docker (persists the model catalog to disk across restarts —
# see README "Model catalog cache"). Same no-relative-default rule as
# HOST_UPLOAD_DIR. Mounted to /data/cache inside the container.
# HOST_CACHE_DIR=/volume1/docker/atlascloud-mcp/cache

# Host-side port mapping for docker-compose.yml (container always listens
# on 3000 internally). Fleet registry slot: 3010.
# HOST_PORT=3010

# Directory for the on-disk model-catalog cache (24h TTL). Optional outside
# Docker — defaults to the OS temp dir. In Docker this is set to /data/cache
# by docker-compose.yml itself (via ATLASCLOUD_CACHE_DIR); no action needed
# here unless running stdio locally and you want a stable cache location.
# ATLASCLOUD_CACHE_DIR=
